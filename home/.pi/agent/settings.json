{
  "lastChangelogVersion": "0.87.1",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-sol",
  "defaultThinkingLevel": "medium",
  "packages": [
    "npm:@ff-labs/pi-fff",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-web-access",
    "npm:pi-subagents",
    "npm:@vanillagreen/pi-tool-renderer",
    "npm:pi-mcp-adapter",
    "./packages/pi-zentui-minimalist",
    "npm:@dietrichgebert/ponytail",
    "npm:omp-startup",
    "npm:@pi-ohm/references",
    "npm:@bacnh85/pi-notify",
    "npm:@narumitw/pi-btw",
    "npm:@lnilluv/pi-ralph-loop",
    "npm:glimpseui"
  ],
  "theme": "rosepine",
  "notify": {
    "onComplete": true,
    "onError": true,
    "onQuestion": true,
    "sound": true
  },
  "kendex": {
    "extensionManager": {
      "disabledItems": [],
      "config": {
        "@vanillagreen/pi-tool-renderer": {
          "compactUserMessages": false,
          "renderMutationTools": true,
          "splitDiffs": true,
          "shikiDiffs": true,
          "wordDiffHighlights": true,
          "diffBackgrounds": true,
          "showDiffHunkMeta": true,
          "toolChrome": "outlines",
          "workingIndicator": "pulse",
          "bashOutputMode": "preview",
          "bashCollapsedLines": 6,
          "bashPreviewLines": 120,
          "bashLiveOutputDelayMs": 600,
          "bashLiveTailLines": 6,
          "commandPreviewChars": 140,
          "renderGitDiffCommandDiffs": true,
          "diffPreviewLines": 40
        }
      }
    }
  },
  "tuiMode": "fullscreen",
  "showHardwareCursor": true,
  "editorPaddingX": 0,
  "outputPad": 1
}
