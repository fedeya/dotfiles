{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/opt/homebrew/bin/bash",
  "update": "auto",
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.envrc",
      "effect": "deny"
    }
  ],
  "plugins": [
    "@prevalentware/opencode-goal-plugin"
  ],
  "mcp": {
    "servers": {
      "proxyman": {
        "type": "local",
        "command": [
          "/Applications/Proxyman.app/Contents/MacOS/mcp-server"
        ]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "grep_app": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      },
      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ]
      }
    }
  },
  "lsp": {
    "ruff": {
      "command": [
        "ruff",
        "server"
      ],
      "extensions": [
        ".py"
      ]
    },
    "ty": {
      "command": [
        "ty",
        "server"
      ],
      "extensions": [
        ".py"
      ]
    },
    "typescript": {
      "disabled": true
    },
    "vtsls": {
      "command": [
        "vtsls",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mts",
        ".cts",
        ".mjs",
        ".cjs"
      ],
      "initialization": {
        "typescript": {
          "updateImportsOnFileMove": "always",
          "tsserver": {
            "maxTsServerMemory": 8192,
            "useSyntaxServer": "auto",
            "experimental": {
              "enableProjectDiagnostics": false
            }
          },
          "suggest": {
            "autoImports": true,
            "completeFunctionCalls": true
          },
          "preferences": {
            "importModuleSpecifier": "shortest",
            "importModuleSpecifierEnding": "auto",
            "includePackageJsonAutoImports": "auto",
            "preferTypeOnlyAutoImports": true,
            "autoImportFileExcludePatterns": [
              "**/node_modules/**",
              "**/dist/**",
              "**/build/**",
              "**/.next/**",
              "**/coverage/**"
            ]
          }
        },
        "javascript": {
          "updateImportsOnFileMove": "always",
          "suggest": {
            "autoImports": true,
            "completeFunctionCalls": true
          },
          "preferences": {
            "importModuleSpecifier": "shortest",
            "importModuleSpecifierEnding": "auto",
            "autoImportFileExcludePatterns": [
              "**/node_modules/**",
              "**/dist/**",
              "**/build/**",
              "**/.next/**",
              "**/coverage/**"
            ]
          }
        },
        "vtsls": {
          "autoUseWorkspaceTsdk": true,
          "enableMoveToFileCodeAction": true,
          "experimental": {
            "completion": {
              "enableServerSideFuzzyMatch": true,
              "entriesLimit": 100
            }
          }
        }
      }
    },
    "pyright": {
      "disabled": true
    }
  }
}
