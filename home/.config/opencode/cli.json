{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "rosepine"
  },
  "keybinds": {
    "session.half.page.up": "ctrl+u",
    "session.half.page.down": "ctrl+d"
  },
  "diffs": {
    "wrap": "word",
    "view": "auto"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "show",
    "markdown": "rendered",
    "image_preview": false,
    "tps": true
  },
  "animations": true,
  "tabs": {
    "mode": "off",
    "layout": "horizontal",
    "indicators": "status",
    "scope": "cwd"
  },
  "attention": {
    "sound": false,
    "notifications": true
  },
  "terminal": {
    "copy": "select"
  },
  "prompt": {
    "paste": "compact",
    "image_preview": true
  },
  "plugins": ["./herdr-opencode"]
}
